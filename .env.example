# ============================================================
# InternHub - Production Environment Variables Example
# Replace placeholders with your actual production credentials.
# ============================================================

# PostgreSQL connection string (supports Neon, Railway, Render, Supabase, or self-hosted Postgres)
# Example: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct URL used for Prisma migrations (optional for pooled setups like Neon)
# DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Secret key used for signing and verifying JWT session tokens (at least 32 characters)
AUTH_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Public application URL (used for absolute links and CORS where applicable)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
